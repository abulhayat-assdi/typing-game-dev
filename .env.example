# ============================================================================
# Typing Adventure Platform — environment template (M1)
# Copy to `.env.local` (local dev) — NEVER commit real secrets.
# All deployment-specific values come from env / `wrangler secret put`,
# never hard-coded in application code.
# ============================================================================

# --- App ---
# public | preview | production
APP_ENV=preview
# Canonical public origin of the web app (used for absolute URLs, callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Default locale: en | bn
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Supabase (self-hosted on your VPS) ---
# Public REST endpoint behind your reverse proxy, e.g. https://supabase.example.com
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
# Safe for browser: anon/public key only
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Set via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
# Direct Postgres connection (server-side scripts/migrations only, pooled in prod)
SUPABASE_DB_URL=postgresql://postgres:placeholder@localhost:5432/postgres

# --- Cloudflare R2 (sole media store) ---
R2_ACCOUNT_ID=placeholder-r2-account-id
R2_ACCESS_KEY_ID=placeholder-r2-access-key-id
# SERVER-ONLY
R2_SECRET_ACCESS_KEY=placeholder-r2-secret-access-key
R2_PUBLIC_BUCKET=tap-r2-public
# Public CDN base URL for R2-served assets (no secrets in URLs)
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://tap-r2-public.example-r2.dev
# SERVER-ONLY private bucket for signed-URL uploads (optional in M1)
R2_PRIVATE_BUCKET=tap-r2-private
# Default presigned-URL lifetime in seconds (route clamps 60..3600)
R2_SIGNED_URL_TTL_SECONDS=600

# --- Auth / session ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=placeholder-auth-secret-change-me

# --- Feature flags (defaults; DB `feature_flags` table is source of truth at runtime) ---
# See supabase/seed/flags.sql — env values below are build-time fallbacks only.
FEATURE_PHASE_1_CORE=true
FEATURE_PHASE_2_ADAPTIVE=false
FEATURE_PHASE_2_REWARDED_ADS=false
FEATURE_PHASE_3_CLAN_WARS=false
FEATURE_PHASE_3_SEASONS=false

# --- Rewarded ads (Phase 2, flag-OFF in M1; provider wired later) ---
ADS_PROVIDER=none
ADS_OFFERWALL_ENABLED=false

# --- Observability (optional) ---
# SENTRY_DSN=
# ANALYTICS_ENDPOINT=
