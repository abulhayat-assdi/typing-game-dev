{
  "name": "typing-adventure-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Typing Adventure Platform — gamified typing-learning adventure (M1 foundation)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "pnpm --filter @tap/web dev",
    "deploy": "pnpm --filter @tap/web deploy",
    "check:env": "tsx scripts/check-env.ts",
    "check:workers": "tsx scripts/validate-workers-config.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "import:content": "tsx scripts/import-content-batch.ts",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tap/content": "workspace:^",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
}
